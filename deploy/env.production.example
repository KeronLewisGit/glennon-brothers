APP_NAME="Glennon Brothers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.glennonbrothers.ie
APP_TIMEZONE=Europe/Dublin
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_glennon
DB_USERNAME=u000000000_glennon
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing mail.
# glennonbrothers.ie mail is filtered by Barracuda (MX *.ess.barracudanetworks.com). Send through the
# group's own mail server or a mailbox it provides, or add Hostinger to the SPF record first; ask
# the group's IT team which. The UK plants use glennonbrothers.co.uk addresses.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=no-reply@glennonbrothers.ie
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@glennonbrothers.ie
MAIL_FROM_NAME="${APP_NAME}"

# true on the temporary preview domain: banner + noindex. Set false at launch.
GB_PREVIEW=false
GB_PUBLIC_EMAIL=info@glennonbrothers.ie
# Who is emailed about new submissions, comma separated. Each area falls back to GB_NOTIFY_EMAIL.
GB_NOTIFY_EMAIL=
GB_NOTIFY_QUOTES=
GB_NOTIFY_FRAME=
GB_NOTIFY_CAREERS=
GB_NOTIFY_DELIVERIES=
GB_NOTIFY_ENQUIRIES=

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
